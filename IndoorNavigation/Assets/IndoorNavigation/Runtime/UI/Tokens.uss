/* Design tokens and shared classes from the blueprint (Spec board, v0.2).
   Sizes are in points on a 390 x 844 reference screen; PanelSettings scales them. */

:root {
    --ground: #EEF0F2;
    --surface: #FFFFFF;
    --text: #14171F;
    --muted: #5B6270;
    --border: #E3E5E8;
    --accent: #0F766E;
    --accent-pressed: #0B5C56;
    --accent-soft: #E3F1EF;
    --you: #2563EB;
    --destination: #D9480F;
    --danger: #B42318;
    --warning-bg: #FFF6E5;
    --warning-text: #7A4A00;
    --warning-border: #F2D19B;
}

/* Every screen instance fills the app; only one is displayed at a time.
   #app itself has no background, so screen A can let the camera view show through. */
#app {
    flex-grow: 1;
}

#app > TemplateContainer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* Safe area: top 60, bottom 34; margins 16 at the screen edge. */
.screen {
    flex-grow: 1;
    padding: 60px 16px 34px 16px;
    background-color: var(--ground);
}

.screen--transparent {
    background-color: rgba(0, 0, 0, 0);
}

.title {
    font-size: 28px;
    -unity-font-style: bold;
    color: var(--text);
    white-space: normal;
    margin: 0 0 8px 0;
}

.body {
    font-size: 16px;
    color: var(--muted);
    white-space: normal;
    margin: 0 0 16px 0;
}

.small {
    font-size: 13px;
    color: var(--muted);
    white-space: normal;
}

.strong {
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--text);
    white-space: normal;
}

.card {
    background-color: var(--surface);
    border-radius: 20px;
    border-width: 1px;
    border-color: var(--border);
    padding: 16px;
    margin: 0 0 12px 0;
}

.sheet {
    background-color: var(--surface);
    border-radius: 24px;
    padding: 20px;
}

.row {
    flex-direction: row;
    align-items: center;
}

.spacer {
    flex-grow: 1;
}

/* Buttons: at least 44 tall to touch, 48-52 for main actions, radius 14. */
.button {
    height: 52px;
    margin: 8px 0 0 0;
    border-radius: 14px;
    border-width: 1px;
    border-color: var(--border);
    background-color: var(--surface);
    color: var(--text);
    font-size: 16px;
    -unity-font-style: bold;
}

.button--primary {
    background-color: var(--accent);
    border-color: var(--accent);
    color: #FFFFFF;
}

.button--primary:active {
    background-color: var(--accent-pressed);
}

.button--danger {
    color: var(--danger);
    border-color: var(--danger);
}

.button--small {
    height: 44px;
    font-size: 14px;
}

.text-field {
    height: 52px;
    margin: 0 0 8px 0;
    font-size: 16px;
}

.warning {
    background-color: var(--warning-bg);
    border-radius: 20px;
    border-width: 1px;
    border-color: var(--warning-border);
    padding: 16px;
    margin: 0 0 12px 0;
}

.warning-text {
    color: var(--warning-text);
    font-size: 15px;
    white-space: normal;
}

.progress-track {
    height: 8px;
    margin: 12px 0;
    border-radius: 4px;
    background-color: var(--border);
}

.progress-fill {
    height: 8px;
    width: 0;
    border-radius: 4px;
    background-color: var(--accent);
}

.map {
    flex-grow: 1;
    min-height: 200px;
    margin: 8px 0;
    border-radius: 20px;
    background-color: var(--surface);
}

.minimap {
    width: 148px;
    height: 148px;
    border-radius: 24px;
    background-color: var(--surface);
}

.chip {
    padding: 8px 12px;
    border-radius: 12px;
    background-color: var(--surface);
    color: var(--text);
    font-size: 14px;
}

.overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    padding: 16px;
    justify-content: center;
    background-color: rgba(20, 23, 31, 0.4);
}

/* Developer panel (W) and its hidden opening corner. */
#developer-panel {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.developer {
    flex-grow: 1;
    padding: 52px 16px 24px 16px;
    background-color: var(--border);
}

.developer-group {
    background-color: var(--surface);
    border-radius: 16px;
    padding: 12px;
    margin: 0 0 8px 0;
}

.developer-buttons {
    flex-direction: row;
    flex-wrap: wrap;
}

.developer-buttons > Button {
    width: 31%;
    height: 44px;
    margin: 4px 1%;
    font-size: 14px;
}

.developer-scroll {
    flex-grow: 1;
}

#developer-hotspot {
    position: absolute;
    left: 0;
    top: 0;
    width: 44px;
    height: 44px;
}

/* World maps screen (developer only): status card, maps by floor, one sheet of actions at the bottom. */
#map-library {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.maps {
    flex-grow: 1;
    padding: 56px 16px 28px 16px;
    background-color: var(--ground);
}

.maps-header {
    flex-shrink: 0;
    margin-bottom: 8px;
}

.maps-title {
    margin: 0;
}

.maps-inline {
    margin: 0;
    padding: 0 14px;
}

.maps-now {
    flex-shrink: 0;
    margin-bottom: 8px;
}

.maps-now > * {
    flex-shrink: 0;
}

.maps-status {
    margin-top: 8px;
}

.maps-message {
    margin-top: 4px;
    color: var(--text);
}

.state-pill {
    font-size: 14px;
    -unity-font-style: bold;
    padding: 4px 12px;
    border-radius: 12px;
    color: var(--muted);
    background-color: var(--ground);
}

.state-pill--busy {
    color: var(--warning-text);
    background-color: var(--warning-bg);
}

.state-pill--ok {
    color: var(--accent);
    background-color: var(--accent-soft);
}

.state-pill--problem {
    color: var(--danger);
    background-color: var(--warning-bg);
}

.maps-list {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 120px;
    margin-bottom: 8px;
}

.maps-floor-heading {
    font-size: 13px;
    -unity-font-style: bold;
    color: var(--muted);
    margin: 10px 4px 4px 4px;
}

.map-card {
    flex-shrink: 0;
    flex-direction: column;
    align-items: stretch;
    height: auto;
    margin: 0 0 6px 0;
    padding: 12px 14px;
    border-radius: 16px;
    border-width: 1px;
    border-color: var(--border);
    background-color: var(--surface);
}

.map-card--selected {
    border-width: 2px;
    border-color: var(--accent);
    background-color: var(--accent-soft);
}

.map-card--empty .map-card-name {
    color: var(--muted);
}

.map-card-top {
    flex-direction: row;
    align-items: center;
}

.map-card-name {
    flex-grow: 1;
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--text);
    -unity-text-align: middle-left;
}

.map-card-tag {
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--accent);
    background-color: var(--accent-soft);
    padding: 2px 8px;
    border-radius: 8px;
}

.map-card-detail {
    font-size: 13px;
    color: var(--muted);
    -unity-text-align: middle-left;
    margin-top: 2px;
}

.maps-sheet {
    flex-shrink: 0;
    padding: 16px;
}

.maps-sheet > * {
    flex-shrink: 0;
}

.maps-buttons {
    flex-shrink: 0;
    margin-top: 4px;
}

.maps-button {
    flex-grow: 1;
    flex-basis: 0;
    margin: 8px 4px 0 4px;
}

.button--danger-solid {
    background-color: var(--danger);
    border-color: var(--danger);
    color: #FFFFFF;
}

.maps-name {
    margin-top: 8px;
}

.maps-floor {
    margin-top: 8px;
}

.maps-floor-label {
    font-size: 16px;
    color: var(--text);
}

.maps-step {
    width: 52px;
    margin: 0;
    font-size: 20px;
}

.maps-floor-value {
    width: 44px;
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: var(--text);
}

.maps-form-message {
    margin-top: 6px;
    color: var(--danger);
}

/* World-map recorder (developer only): over the camera, with a crosshair in the exact middle. */
#map-recorder {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.recorder {
    flex-grow: 1;
    padding: 60px 16px 34px 16px;
}

.crosshair {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 32px;
    height: 32px;
    margin-left: -16px;
    margin-top: -16px;
    border-width: 3px;
    border-radius: 16px;
    border-color: var(--destination);
}

/* The recorder's live map. Its colours are the app's tokens, read by MapRecorderPresenter. */
.coverage-box {
    flex-shrink: 0;
    align-self: flex-end;
    align-items: center;
    margin-top: 8px;
}

.mapping-badge {
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--surface);
    background-color: rgba(20, 23, 31, 0.6);
    padding: 2px 10px;
    border-radius: 10px;
    margin-bottom: 6px;
}

.mapping-badge--limited {
    background-color: var(--danger);
}

.mapping-badge--extending {
    background-color: var(--warning-text);
}

.mapping-badge--mapped {
    background-color: var(--accent);
}

.coverage {
    width: 168px;
    height: 168px;
    border-radius: 12px;
    background-color: rgba(20, 23, 31, 0.62);
    overflow: hidden;
    --coverage-cell: var(--accent-soft);
    --coverage-path: var(--destination);
    --coverage-you: var(--you);
    --coverage-mark: var(--warning-border);
    --coverage-earlier: var(--muted);
}

.coverage-text {
    font-size: 11px;
    white-space: nowrap;
    color: var(--surface);
    background-color: rgba(20, 23, 31, 0.6);
    padding: 1px 8px;
    border-radius: 8px;
    margin-top: 4px;
}

/* Recorder layout: fixed-size parts never shrink, so text and buttons cannot overlap. */
.recorder-card {
    flex-shrink: 0;
    padding: 12px 16px;
}

.recorder-progress {
    margin-top: 4px;
    color: var(--text);
}

.recorder-message {
    margin-top: 2px;
}

.recorder-sheet {
    flex-shrink: 0;
    padding: 12px 12px 16px 12px;
}

.recorder-doors {
    flex-shrink: 0;
    height: 40px;
    margin: 0 4px 4px 4px;
}

.recorder-doors-empty {
    font-size: 13px;
    color: var(--muted);
    -unity-text-align: middle-left;
    height: 36px;
}

.door-chip {
    flex-shrink: 0;
    height: 36px;
    margin: 0 6px 0 0;
    padding: 0 12px;
    border-radius: 18px;
    border-width: 0;
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--accent);
    background-color: var(--accent-soft);
}

.door-chip--check {
    color: var(--warning-text);
    background-color: var(--warning-bg);
}

.door-chip--redo {
    border-width: 2px;
    border-color: var(--destination);
}

.recorder-row {
    flex-shrink: 0;
}

.recorder-button {
    flex-grow: 1;
    flex-basis: 0;
    margin: 8px 4px 0 4px;
}

.recorder-button--wide {
    flex-grow: 2;
}

.button--accent {
    color: var(--accent);
    border-color: var(--accent);
    border-width: 2px;
}

/* Screen 1 · finding your position, and 1b · marking a door (decision record 11).
   Both are transparent over the camera; the sheet and card never shrink. */
.locate-chip {
    align-self: flex-start;
}

.locate-sheet {
    flex-shrink: 0;
}

.locate-hint {
    color: var(--text);
    margin: 0 0 4px 0;
}

.locate-doors {
    flex-shrink: 0;
    margin-top: 8px;
}

.locate-door-intro {
    margin-bottom: 4px;
}

.locate-door-list {
    max-height: 300px;
}

.locate-floor {
    font-size: 13px;
    -unity-font-style: bold;
    color: var(--muted);
    margin: 10px 0 0 4px;
}

.locate-door {
    height: 48px;
    margin: 6px 0 0 0;
    padding-left: 16px;
    -unity-text-align: middle-left;
}

.mark-card {
    flex-shrink: 0;
}

.mark-text {
    flex-grow: 1;
    flex-shrink: 1;
}

.mark-step {
    margin-top: 4px;
    color: var(--text);
    font-size: 15px;
}

.mark-problem {
    margin-top: 10px;
}

/* A door seen from the front: two posts and the lintel, and a dot on each floor corner. */
.door-drawing {
    flex-shrink: 0;
    width: 56px;
    height: 72px;
    margin-left: 14px;
    border-left-width: 5px;
    border-right-width: 5px;
    border-top-width: 5px;
    border-color: var(--muted);
}

.door-corner {
    position: absolute;
    bottom: -9px;
    width: 14px;
    height: 14px;
    border-radius: 7px;
    background-color: var(--border);
}

.door-corner--left {
    left: -10px;
}

.door-corner--right {
    right: -10px;
}

.door-corner--next {
    background-color: var(--destination);
}

.door-corner--done {
    background-color: var(--accent);
}

.mark-sheet {
    flex-shrink: 0;
    padding: 12px 12px 16px 12px;
}

.mark-button {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0 4px;
}

.mark-button--wide {
    flex-grow: 2;
}

/* "Fix position" on the navigation screens. */
.fix-row {
    flex-shrink: 0;
    margin-bottom: 8px;
}

.door-sheet {
    flex-shrink: 0;
    margin: 0 4px 8px 4px;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-color: var(--border);
}

.half-button {
    flex-grow: 1;
    flex-basis: 0;
    margin: 8px 4px 0 4px;
}

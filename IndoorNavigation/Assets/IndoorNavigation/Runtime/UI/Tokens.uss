/* Design tokens and shared classes from the blueprint (Spec board, v0.2).
   Sizes are in points on a 390 x 844 reference screen; PanelSettings scales them. */

:root {
    --ground: #EEF0F2;
    --surface: #FFFFFF;
    --text: #14171F;
    --muted: #5B6270;
    --border: #E3E5E8;
    --accent: #0F766E;
    --accent-pressed: #0B5C56;
    --accent-soft: #E3F1EF;
    --you: #2563EB;
    --destination: #D9480F;
    --danger: #B42318;
    --warning-bg: #FFF6E5;
    --warning-text: #7A4A00;
    --warning-border: #F2D19B;
    /* Atkinson Hyperlegible (Braille Institute, SIL Open Font License 1.1; see Fonts/OFL.txt). */
    -unity-font-definition: url("Fonts/AtkinsonHyperlegible-Regular.ttf");
}

/* Every screen instance fills the app; only one is displayed at a time.
   #app itself has no background, so screen A can let the camera view show through. */
#app {
    flex-grow: 1;
}

#app > TemplateContainer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* Safe area: top 60, bottom 34; margins 16 at the screen edge. */
.screen {
    flex-grow: 1;
    padding: 60px 16px 34px 16px;
    background-color: var(--ground);
}

.screen--transparent {
    background-color: rgba(0, 0, 0, 0);
}

.title {
    font-size: 24px;
    -unity-font-definition: url("Fonts/AtkinsonHyperlegible-Bold.ttf"); -unity-font-style: normal;
    color: var(--text);
    white-space: normal;
    margin: 0 0 8px 0;
}

.body {
    font-size: 16px;
    color: var(--muted);
    white-space: normal;
    margin: 0 0 16px 0;
}

.small {
    font-size: 13px;
    color: var(--muted);
    white-space: normal;
}

.strong {
    font-size: 18px;
    -unity-font-definition: url("Fonts/AtkinsonHyperlegible-Bold.ttf"); -unity-font-style: normal;
    color: var(--text);
    white-space: normal;
}

.card {
    background-color: var(--surface);
    border-radius: 20px;
    border-width: 1px;
    border-color: var(--border);
    padding: 16px;
    margin: 0 0 12px 0;
}

.sheet {
    background-color: var(--surface);
    border-radius: 24px;
    padding: 20px;
}

.row {
    flex-direction: row;
    align-items: center;
}

.spacer {
    flex-grow: 1;
}

/* Buttons: at least 44 tall to touch, 48-52 for main actions, radius 14. */
.button {
    height: 52px;
    margin: 8px 0 0 0;
    border-radius: 14px;
    border-width: 1px;
    border-color: var(--border);
    background-color: var(--surface);
    color: var(--text);
    font-size: 16px;
    -unity-font-definition: url("Fonts/AtkinsonHyperlegible-Bold.ttf"); -unity-font-style: normal;
}

.button--primary {
    background-color: var(--accent);
    border-color: var(--accent);
    color: #FFFFFF;
}

.button--primary:active {
    background-color: var(--accent-pressed);
}

.button--danger {
    color: var(--danger);
    border-color: var(--danger);
}

.button--small {
    height: 44px;
    font-size: 14px;
}

.text-field {
    height: 52px;
    margin: 0 0 8px 0;
    font-size: 16px;
}

.warning {
    background-color: var(--warning-bg);
    border-radius: 20px;
    border-width: 1px;
    border-color: var(--warning-border);
    padding: 16px;
    margin: 0 0 12px 0;
}

.warning-text {
    color: var(--warning-text);
    font-size: 15px;
    white-space: normal;
}

.progress-track {
    height: 8px;
    margin: 12px 0;
    border-radius: 4px;
    background-color: var(--border);
}

.progress-fill {
    height: 8px;
    width: 0;
    border-radius: 4px;
    background-color: var(--accent);
}

.map {
    flex-grow: 1;
    min-height: 200px;
    margin: 8px 0;
    border-radius: 20px;
    border-width: 1px;
    border-color: var(--border);
    background-color: var(--ground);
    overflow: hidden;
}

.minimap {
    width: 148px;
    height: 148px;
    border-radius: 24px;
    background-color: var(--surface);
}

.chip {
    padding: 8px 12px;
    border-radius: 12px;
    background-color: var(--surface);
    color: var(--text);
    font-size: 14px;
}

.overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    padding: 16px;
    justify-content: center;
    background-color: rgba(20, 23, 31, 0.4);
}

/* Developer panel (W) and its hidden opening corner. */
#developer-panel {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.developer {
    flex-grow: 1;
    padding: 52px 16px 24px 16px;
    background-color: var(--border);
}

.developer-group {
    background-color: var(--surface);
    border-radius: 16px;
    padding: 12px;
    margin: 0 0 8px 0;
}

.developer-buttons {
    flex-direction: row;
    flex-wrap: wrap;
}

.developer-buttons > Button {
    width: 31%;
    height: 44px;
    margin: 4px 1%;
    font-size: 14px;
}

.developer-scroll {
    flex-grow: 1;
}

#developer-hotspot {
    position: absolute;
    left: 0;
    top: 0;
    width: 44px;
    height: 44px;
}

/* World maps screen (developer only): status card, maps by floor, one sheet of actions at the bottom. */
#map-library {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.maps {
    flex-grow: 1;
    padding: 56px 16px 28px 16px;
    background-color: var(--ground);
}

.maps-header {
    flex-shrink: 0;
    margin-bottom: 8px;
}

.maps-title {
    margin: 0;
}

.maps-inline {
    margin: 0;
    padding: 0 14px;
}

.maps-now {
    flex-shrink: 0;
    margin-bottom: 8px;
}

.maps-now > * {
    flex-shrink: 0;
}

.maps-status {
    margin-top: 8px;
}

.maps-message {
    margin-top: 4px;
    color: var(--text);
}

.state-pill {
    font-size: 14px;
    -unity-font-definition: url("Fonts/AtkinsonHyperlegible-Bold.ttf"); -unity-font-style: normal;
    padding: 4px 12px;
    border-radius: 12px;
    color: var(--muted);
    background-color: var(--ground);
}

.state-pill--busy {
    color: var(--warning-text);
    background-color: var(--warning-bg);
}

.state-pill--ok {
    color: var(--accent);
    background-color: var(--accent-soft);
}

.state-pill--problem {
    color: var(--danger);
    background-color: var(--warning-bg);
}

.maps-list {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 120px;
    margin-bottom: 8px;
}

.maps-floor-heading {
    font-size: 13px;
    -unity-font-definition: url("Fonts/AtkinsonHyperlegible-Bold.ttf"); -unity-font-style: normal;
    color: var(--muted);
    margin: 10px 4px 4px 4px;
}

.map-card {
    flex-shrink: 0;
    flex-direction: column;
    align-items: stretch;
    height: auto;
    margin: 0 0 6px 0;
    padding: 12px 14px;
    border-radius: 16px;
    border-width: 1px;
    border-color: var(--border);
    background-color: var(--surface);
}

.map-card--selected {
    border-width: 2px;
    border-color: var(--accent);
    background-color: var(--accent-soft);
}

.map-card--empty .map-card-name {
    color: var(--muted);
}

.map-card-top {
    flex-direction: row;
    align-items: center;
}

.map-card-name {
    flex-grow: 1;
    font-size: 16px;
    -unity-font-definition: url("Fonts/AtkinsonHyperlegible-Bold.ttf"); -unity-font-style: normal;
    color: var(--text);
    -unity-text-align: middle-left;
}

.map-card-tag {
    font-size: 12px;
    -unity-font-definition: url("Fonts/AtkinsonHyperlegible-Bold.ttf"); -unity-font-style: normal;
    color: var(--accent);
    background-color: var(--accent-soft);
    padding: 2px 8px;
    border-radius: 8px;
}

.map-card-detail {
    font-size: 13px;
    color: var(--muted);
    -unity-text-align: middle-left;
    margin-top: 2px;
}

.maps-sheet {
    flex-shrink: 0;
    padding: 16px;
}

.maps-sheet > * {
    flex-shrink: 0;
}

.maps-buttons {
    flex-shrink: 0;
    margin-top: 4px;
}

.maps-button {
    flex-grow: 1;
    flex-basis: 0;
    margin: 8px 4px 0 4px;
}

.button--danger-solid {
    background-color: var(--danger);
    border-color: var(--danger);
    color: #FFFFFF;
}

.maps-name {
    margin-top: 8px;
}

.maps-floor {
    margin-top: 8px;
}

.maps-floor-label {
    font-size: 16px;
    color: var(--text);
}

.maps-step {
    width: 52px;
    margin: 0;
    font-size: 20px;
}

.maps-floor-value {
    width: 44px;
    font-size: 20px;
    -unity-font-definition: url("Fonts/AtkinsonHyperlegible-Bold.ttf"); -unity-font-style: normal;
    -unity-text-align: middle-center;
    color: var(--text);
}

.maps-form-message {
    margin-top: 6px;
    color: var(--danger);
}

/* World-map recorder (developer only): over the camera, with a crosshair in the exact middle. */
#map-recorder {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.recorder {
    flex-grow: 1;
    padding: 60px 16px 34px 16px;
}

.crosshair {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 32px;
    height: 32px;
    margin-left: -16px;
    margin-top: -16px;
    border-width: 3px;
    border-radius: 16px;
    border-color: var(--destination);
}

/* The recorder's live map, inside the top card beside the text. Its colours are the app's tokens,
   read by MapRecorderPresenter. Nothing but the crosshair is in the middle of the screen, on any phone. */
.coverage-box {
    flex-shrink: 0;
    align-self: flex-start;
    align-items: center;
    width: 112px;
    margin-left: 10px;
}

.mapping-badge {
    font-size: 11px;
    -unity-font-definition: url("Fonts/AtkinsonHyperlegible-Bold.ttf"); -unity-font-style: normal;
    color: var(--surface);
    background-color: rgba(20, 23, 31, 0.6);
    padding: 2px 10px;
    border-radius: 10px;
    margin-bottom: 6px;
}

.mapping-badge--limited {
    background-color: var(--danger);
}

.mapping-badge--extending {
    background-color: var(--warning-text);
}

.mapping-badge--mapped {
    background-color: var(--accent);
}

.coverage {
    width: 112px;
    height: 112px;
    border-radius: 12px;
    background-color: rgba(20, 23, 31, 0.62);
    overflow: hidden;
    --coverage-cell: var(--accent-soft);
    --coverage-path: var(--destination);
    --coverage-you: var(--you);
    --coverage-mark: var(--warning-border);
    --coverage-earlier: var(--muted);
}

.coverage-text {
    font-size: 11px;
    white-space: normal;
    -unity-text-align: middle-center;
    max-width: 112px;
    color: var(--surface);
    background-color: rgba(20, 23, 31, 0.6);
    padding: 1px 8px;
    border-radius: 8px;
    margin-top: 4px;
}

/* Recorder layout: fixed-size parts never shrink, so text and buttons cannot overlap. */
.recorder-card {
    flex-shrink: 0;
    padding: 12px 16px;
}

.recorder-progress {
    margin-top: 4px;
    color: var(--text);
}

.recorder-message {
    margin-top: 2px;
}

.recorder-sheet {
    flex-shrink: 0;
    padding: 12px 12px 16px 12px;
}

.recorder-doors {
    flex-shrink: 0;
    flex-direction: row;
    flex-wrap: wrap;
    margin: 0 4px 0 4px;
}

.recorder-doors-empty {
    font-size: 13px;
    color: var(--muted);
    -unity-text-align: middle-left;
    height: 44px;
}

/* 44 points high: Apple's default control size on iOS, 44 x 44 pt (Human Interface Guidelines, Accessibility). */
.door-chip {
    flex-shrink: 0;
    height: 44px;
    max-width: 48%;
    margin: 0 6px 6px 0;
    padding: 0 14px;
    border-radius: 22px;
    border-width: 0;
    font-size: 14px;
    -unity-font-definition: url("Fonts/AtkinsonHyperlegible-Bold.ttf"); -unity-font-style: normal;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--accent);
    background-color: var(--accent-soft);
}

.door-chip--more {
    color: var(--text);
    background-color: var(--ground);
}

.door-chip--check {
    color: var(--warning-text);
    background-color: var(--warning-bg);
}

.door-chip--redo {
    border-width: 2px;
    border-color: var(--destination);
}

.recorder-row {
    flex-shrink: 0;
}

.recorder-button {
    flex-grow: 1;
    flex-basis: 0;
    margin: 8px 4px 0 4px;
}

.recorder-button--wide {
    flex-grow: 2;
}

.button--accent {
    color: var(--accent);
    border-color: var(--accent);
    border-width: 2px;
}

/* Screen 1 · finding your position, and 1b · marking a door (decision record 11).
   Both are transparent over the camera; the sheet and card never shrink. */
.locate-chip {
    align-self: flex-start;
}

.locate-sheet {
    flex-shrink: 0;
}

.locate-hint {
    color: var(--text);
    margin: 0 0 4px 0;
}

.locate-doors {
    flex-shrink: 0;
    margin-top: 8px;
}

.locate-door-intro {
    margin-bottom: 4px;
}

.locate-door-list {
    max-height: 300px;
}

.locate-floor {
    font-size: 13px;
    -unity-font-definition: url("Fonts/AtkinsonHyperlegible-Bold.ttf"); -unity-font-style: normal;
    color: var(--muted);
    margin: 10px 0 0 4px;
}

.locate-door {
    height: 48px;
    margin: 6px 0 0 0;
    padding-left: 16px;
    -unity-text-align: middle-left;
}

.mark-card {
    flex-shrink: 0;
}

.mark-text {
    flex-grow: 1;
    flex-shrink: 1;
}

.mark-step {
    margin-top: 4px;
    color: var(--text);
    font-size: 15px;
}

.mark-problem {
    margin-top: 10px;
}

/* A door seen from the front: two posts and the lintel, and a dot on each floor corner. */
.door-drawing {
    flex-shrink: 0;
    width: 56px;
    height: 72px;
    margin-left: 14px;
    border-left-width: 5px;
    border-right-width: 5px;
    border-top-width: 5px;
    border-color: var(--muted);
}

.door-corner {
    position: absolute;
    bottom: -9px;
    width: 14px;
    height: 14px;
    border-radius: 7px;
    background-color: var(--border);
}

.door-corner--left {
    left: -10px;
}

.door-corner--right {
    right: -10px;
}

.door-corner--next {
    background-color: var(--destination);
}

.door-corner--done {
    background-color: var(--accent);
}

.mark-sheet {
    flex-shrink: 0;
    padding: 12px 12px 16px 12px;
}

.mark-button {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0 4px;
}

.mark-button--wide {
    flex-grow: 2;
}

/* "Fix position" on the navigation screens. */
.fix-row {
    flex-shrink: 0;
    margin-bottom: 8px;
}

.door-sheet {
    flex-shrink: 0;
    margin: 0 4px 8px 4px;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-color: var(--border);
}

.half-button {
    flex-grow: 1;
    flex-basis: 0;
    margin: 8px 4px 0 4px;
}

.door-room {
    margin: 6px 0 2px 0;
    font-size: 15px;
}

.locate-floor-row {
    flex-shrink: 0;
    margin-bottom: 4px;
}

.locate-floor-chosen {
    color: var(--text);
    -unity-font-definition: url("Fonts/AtkinsonHyperlegible-Bold.ttf"); -unity-font-style: normal;
}

.locate-change {
    margin: 0;
    padding: 0 14px;
}


/* Adaptable layout. Text and buttons in sheets and cards keep their height; when a screen is short,
   only the scrolling lists give way. This stops labels from being squeezed into each other. */
.sheet > Label,
.sheet > Button,
.sheet > TextField,
.sheet > Toggle,
.card > Label,
.card > Button,
.sheet > .row,
.card > .row {
    flex-shrink: 0;
}

.locate-sheet {
    max-height: 88%;
}

.locate-doors {
    flex-shrink: 1;
    min-height: 0;
}

.locate-door-list {
    flex-shrink: 1;
    min-height: 0;
}

.locate-doors > Label,
.locate-doors > Button {
    flex-shrink: 0;
}

.door-sheet > * {
    flex-shrink: 0;
}

.recorder-card-row {
    align-items: flex-start;
}

.recorder-text {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
}

.recorder-text > Label {
    flex-shrink: 0;
}

/* A long destination name gives way to the "Arrows look wrong?" button, cut with an ellipsis. */
.fix-row > .chip {
    flex-shrink: 1;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

/* D · 3D miniature, and the "3D" switch on the 2D maps (decision record 8). */


.miniature-title {
    flex-grow: 1;
    flex-shrink: 1;
    margin-right: 8px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.segmented {
    flex-direction: row;
    flex-shrink: 0;
    padding: 3px;
    border-radius: 14px;
    background-color: var(--border);
}

.segment {
    width: 56px;
    height: 44px;
    margin: 0;
    border-width: 0;
    border-radius: 11px;
    background-color: rgba(0, 0, 0, 0);
    color: var(--muted);
    font-size: 15px;
    -unity-font-definition: url("Fonts/AtkinsonHyperlegible-Bold.ttf"); -unity-font-style: normal;
}

.segment--on {
    background-color: var(--surface);
    color: var(--text);
}

.miniature-view {
    overflow: hidden;
    background-color: var(--ground);
}

.miniature-labels {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.miniature-floor {
    position: absolute;
    padding: 2px 8px;
    border-radius: 8px;
    background-color: rgba(255, 255, 255, 0.85);
    color: var(--muted);
    font-size: 12px;
    -unity-font-definition: url("Fonts/AtkinsonHyperlegible-Bold.ttf"); -unity-font-style: normal;
}

.miniature-floor--you {
    color: var(--you);
}

.miniature-destination {
    position: absolute;
    width: 160px;
    color: var(--destination);
    font-size: 13px;
    -unity-font-definition: url("Fonts/AtkinsonHyperlegible-Bold.ttf"); -unity-font-style: normal;
    -unity-text-align: middle-center;
    white-space: normal;
}

.miniature-hint {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 10px;
    color: var(--muted);
    font-size: 12px;
    -unity-text-align: middle-center;
}

/* Map controls on the 2D map (blueprint: 2D/3D switch top left; round map controls 52 at the right, 12 apart). */
.segmented--map {
    position: absolute;
    top: 10px;
    left: 10px;
    background-color: rgba(255, 255, 255, 0.92);
    border-width: 1px;
    border-color: var(--border);
}

.segmented--map .segment--on {
    background-color: var(--accent-soft);
    color: var(--accent);
}

.map-controls {
    position: absolute;
    top: 10px;
    right: 10px;
}

.map-control {
    width: 52px;
    height: 52px;
    margin: 0 0 12px 0;
    padding: 0;
    border-radius: 26px;
    border-width: 1px;
    border-color: var(--border);
    background-color: var(--surface);
    align-items: center;
    justify-content: center;
}

.map-control--on {
    background-color: var(--accent-soft);
    border-color: var(--accent);
}

.map-label {
    position: absolute;
    width: 120px;
    font-size: 11px;
    color: var(--muted);
    -unity-text-align: middle-center;
}

/* 1 · "Where on this floor?" chips (decision record 13): optional, wrap over lines. */
.locate-areas {
    flex-shrink: 0;
    margin: 4px 0 6px 0;
}

.area-chips {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 6px;
}

.area-chip {
    height: 44px;
    margin: 0 8px 8px 0;
    padding: 0 14px;
    border-radius: 22px;
    border-width: 1px;
    border-color: var(--border);
    background-color: var(--surface);
    color: var(--text);
    font-size: 14px;
}

.area-chip--on {
    border-color: var(--accent);
    background-color: var(--accent-soft);
    color: var(--accent);
    -unity-font-definition: url("Fonts/AtkinsonHyperlegible-Bold.ttf"); -unity-font-style: normal;
}

/* A · destination pin over the camera view (screen-space, constant size). */
.ar-pin {
    position: absolute;
    width: 180px;
    align-items: center;
}

.ar-pin-label {
    margin-top: 4px;
    padding: 4px 10px;
    border-radius: 12px;
    background-color: rgba(20, 23, 31, 0.86);
    color: #FFFFFF;
    font-size: 13px;
    -unity-font-definition: url("Fonts/AtkinsonHyperlegible-Bold.ttf"); -unity-font-style: normal;
}

/* Visitor screens: blueprint v0.2, pages 2-12. Keep the plan open behind floating controls. */
.screen > .title { margin-top: 20px; }
.screen > .row { flex-shrink: 0; }
.button { flex-shrink: 0; white-space: normal; }
.button:disabled { opacity: 0.45; }
.button:focus, .map-control:focus, .segment:focus { border-color: var(--accent); }
.button--soft { background-color: var(--accent-soft); color: var(--accent); border-width: 0; }
.text-button {
    flex-shrink: 0;
    min-height: 44px;
    margin: 0;
    padding: 8px 12px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--accent);
    font-size: 14px;
    -unity-font-definition: url("Fonts/AtkinsonHyperlegible-Bold.ttf"); -unity-font-style: normal;
}
.text-field { flex-shrink: 0; min-height: 52px; }
.text-field > .unity-text-field__input {
    padding: 12px 16px;
    border-radius: 14px;
    border-width: 1px;
    border-color: var(--border);
    background-color: var(--surface);
    color: var(--text);
}
.text-field > .unity-text-field__input:focus { border-color: var(--accent); }
.section-label { font-size: 13px; -unity-font-definition: url("Fonts/AtkinsonHyperlegible-Bold.ttf"); -unity-font-style: normal; color: var(--muted); margin: 20px 0 10px 0; }
.visitor-scroll { flex-grow: 1; flex-shrink: 1; min-height: 0; }
.visitor-scroll .unity-scroll-view__content-container { padding-bottom: 12px; }
.visitor-scroll > .unity-scroll-view__vertical-scroller { display: none; }
.visitor-footer { flex-shrink: 0; padding-top: 8px; }
.building-row { margin-bottom: 16px; }
.building-row > .chip { flex-shrink: 1; white-space: normal; border-radius: 20px; font-size: 13px; }
.building-row > Button { flex-shrink: 0; }
.catalogue-card {
    flex-shrink: 0;
    min-height: 76px;
    height: auto;
    margin: 0 0 10px 0;
    padding: 16px;
    flex-direction: column;
    align-items: stretch;
    border-radius: 20px;
    border-width: 1px;
    border-color: var(--border);
    background-color: var(--surface);
    -unity-text-align: middle-left;
}
.catalogue-card > Label { flex-shrink: 0; margin: 2px 0; }
.catalogue-card:active { background-color: var(--accent-soft); }
.catalogue-card .strong { font-size: 18px; }
.common-places { flex-direction: row; flex-wrap: wrap; flex-shrink: 0; }
.common-chip {
    min-height: 44px;
    padding: 8px 16px;
    margin: 0 8px 8px 0;
    border-radius: 22px;
    border-width: 1px;
    border-color: var(--border);
    background-color: var(--surface);
    color: var(--text);
    font-size: 14px;
}
.route-screen { padding: 60px 0 34px 0; }
.instruction-card {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    min-height: 80px;
    margin: 0 16px 8px 16px;
    padding: 12px 16px;
    border-radius: 20px;
    border-width: 1px;
    border-color: var(--border);
    background-color: var(--surface);
    -unity-text-align: middle-left;
}
.instruction-copy { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.instruction-copy > Label { flex-shrink: 0; white-space: normal; margin: 0 0 2px 0; }
.instruction-title { font-size: 22px; -unity-font-definition: url("Fonts/AtkinsonHyperlegible-Bold.ttf"); -unity-font-style: normal; color: var(--text); white-space: normal; }
.instruction-card--warning { background-color: var(--warning-bg); border-color: var(--warning-border); }
.instruction-card--warning Label { color: var(--warning-text); }
.icon-tile {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    margin-right: 12px;
    border-radius: 14px;
    background-color: var(--accent-soft);
    align-items: center;
    justify-content: center;
}
.icon-tile--destination { background-color: #FCEDE7; }
.icon-tile--destination > * { width: 22px; height: 30px; }
.route-map { min-height: 180px; margin: 0; border-width: 0; border-radius: 0; flex-shrink: 1; }
.route-map > .segmented--map { top: 8px; left: 16px; }
.route-map > .map-controls { top: auto; bottom: 8px; right: 16px; }
.route-map .map-control { width: 48px; height: 48px; margin-bottom: 8px; }
.route-map--compact > .map-controls { flex-direction: row; bottom: 8px; }
.route-map--compact .map-control { margin: 0 0 0 8px; }
.route-map--compact > .map-status { top: 64px; bottom: auto; }
.floor-badge {
    position: absolute;
    top: -4px;
    right: -3px;
    min-width: 20px;
    height: 20px;
    padding: 0 4px;
    border-radius: 10px;
    border-width: 2px;
    border-color: var(--surface);
    background-color: var(--accent);
    color: #FFFFFF;
    font-size: 11px;
    -unity-font-definition: url("Fonts/AtkinsonHyperlegible-Bold.ttf"); -unity-font-style: normal;
    -unity-text-align: middle-center;
}
.map-status {
    position: absolute;
    bottom: 12px;
    left: 16px;
    max-width: 68%;
    padding: 6px 12px;
    border-radius: 14px;
    background-color: var(--surface);
    color: var(--muted);
    font-size: 12px;
    white-space: normal;
}
.other-floor-banner { flex-shrink: 0; margin: 0 16px 4px 16px; }
.other-floor-banner > Button { margin: 0; padding: 0 16px; }
.route-sheet { flex-shrink: 0; padding: 10px 20px 8px 20px; border-bottom-left-radius: 0; border-bottom-right-radius: 0; }
.route-sheet > * { flex-shrink: 0; }
.sheet-handle { align-self: center; width: 36px; height: 4px; margin: 0 0 14px 0; border-radius: 2px; background-color: #D1D6DD; }
.destination-row { margin: 2px 0 8px 0; }
.route-summary { font-size: 22px; -unity-font-definition: url("Fonts/AtkinsonHyperlegible-Bold.ttf"); -unity-font-style: normal; color: var(--text); margin: 0 0 12px 0; }
.route-option { padding: 12px; min-height: 48px; margin: 0; border-width: 1px; border-color: var(--border); border-radius: 14px; font-size: 16px; color: var(--text); }
.route-option > .unity-toggle__label { flex-grow: 1; -unity-font-definition: url("Fonts/AtkinsonHyperlegible-Bold.ttf"); -unity-font-style: normal; }
.route-option .unity-toggle__checkmark { width: 44px; height: 26px; padding: 4px; border-radius: 13px; border-width: 0; background-image: none; background-color: #D1D6DD; flex-direction: row; align-items: center; justify-content: flex-start; }
.route-option:checked .unity-toggle__checkmark { background-image: none; background-color: var(--accent); justify-content: flex-end; }
.toggle-knob { flex-shrink: 0; width: 18px; height: 18px; border-radius: 9px; background-color: #FFFFFF; }
.back-button { width: 44px; height: 44px; margin: 0 12px 0 0; border-width: 0; border-radius: 22px; background-color: var(--ground); color: var(--text); font-size: 30px; }
.dialog-sheet { max-height: 86%; flex-shrink: 1; }
.dialog-body { flex-shrink: 1; min-height: 0; }
.dialog-body .unity-scroll-view__content-container { padding-bottom: 8px; }
.step-row { flex-shrink: 0; padding: 14px 12px; border-bottom-width: 1px; border-color: var(--border); }
.step-row .strong { font-size: 16px; margin-bottom: 6px; }
.step-row--current { background-color: var(--accent-soft); border-radius: 14px; }
.tip-row { flex-shrink: 0; padding: 14px 0; white-space: normal; color: var(--text); font-size: 16px; border-bottom-width: 1px; border-color: var(--border); }
.first-tip-row { margin-bottom: 16px; align-items: stretch; }
.first-tip-option { flex-grow: 1; flex-basis: 0; padding: 16px 10px; margin: 0 4px; border-radius: 16px; background-color: var(--ground); }
.first-tip-option > Label { white-space: normal; margin: 4px 0; }
.ar-screen > .instruction-card { margin: 0 0 12px 0; }
.ar-destination { align-self: flex-start; max-width: 90%; border-radius: 16px; padding: 8px 14px; background-color: var(--text); color: #FFFFFF; font-size: 13px; white-space: normal; }
.ar-bottom { align-items: flex-end; flex-shrink: 0; }
.ar-controls .map-control { width: 56px; height: 56px; border-radius: 28px; margin-bottom: 12px; }
.minimap-button { width: 148px; height: 148px; padding: 0; margin: 0 0 12px 0; border-width: 2px; border-color: var(--surface); border-radius: 24px; overflow: hidden; }
.minimap { width: 144px; height: 144px; overflow: hidden; }
.ar-fix { align-self: center; background-color: var(--surface); border-radius: 22px; padding: 8px 16px; }
.ar-recovery { align-self: center; min-height: 44px; padding: 10px 16px; border-width: 0; border-radius: 22px; background-color: var(--text); color: #FFFFFF; font-size: 14px; }

/* ------------------------------------------------------------------------------------------------
   Blueprint pass 2 (build 19): type, lists, pills, icons and sheets as drawn on pages 2-12.
   Bold text uses the bold font file, so no rule relies on a synthesised bold.
   ------------------------------------------------------------------------------------------------ */

/* Type scale of the specification: 22 instruction, 18-20 sheet title, 16 button, 15 meta, 13 labels. */
.sheet-title { font-size: 20px; -unity-font-definition: url("Fonts/AtkinsonHyperlegible-Bold.ttf"); color: var(--text); white-space: normal; margin: 0 0 4px 0; }
.list-title { font-size: 16px; -unity-font-definition: url("Fonts/AtkinsonHyperlegible-Bold.ttf"); color: var(--text); white-space: normal; }
.header-label { font-size: 16px; -unity-font-definition: url("Fonts/AtkinsonHyperlegible-Bold.ttf"); color: var(--text); }
.body { font-size: 15px; }
.footnote { flex-shrink: 0; margin: 4px 4px 8px 4px; }
.sheet-copy { margin-bottom: 10px; }
.dialog-text { margin: 0 0 12px 0; font-size: 15px; }

/* Lists: one card, rows divided by hairlines (V1, 2, 2b, 5, 5c, B2, F3). */
.list-card { flex-shrink: 0; margin: 0 0 12px 0; border-radius: 20px; border-width: 1px; border-color: var(--border); background-color: var(--surface); overflow: hidden; }
.list-row { flex-direction: row; align-items: center; flex-shrink: 0; min-height: 60px; height: auto; margin: 0; padding: 10px 14px; border-width: 0; border-top-width: 1px; border-color: var(--border); border-radius: 0; background-color: rgba(0, 0, 0, 0); -unity-text-align: middle-left; white-space: normal; }
.list-row--first { border-top-width: 0; }
Button.list-row:active { background-color: var(--accent-soft); }
.list-row--on { background-color: var(--accent-soft); }
.list-row--plain .list-title { -unity-font-definition: url("Fonts/AtkinsonHyperlegible-Regular.ttf"); }
.list-copy { flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-width: 0; align-items: flex-start; }
.list-copy > Label { flex-shrink: 0; margin: 1px 0; padding: 0; }
.list-row > .icon-tile { width: 40px; height: 40px; border-radius: 12px; }
.list-trailing { flex-shrink: 0; margin-left: 10px; }
.list-value { flex-shrink: 0; font-size: 14px; -unity-font-definition: url("Fonts/AtkinsonHyperlegible-Bold.ttf"); color: var(--text); -unity-text-align: middle-right; }
.number-tile { flex-shrink: 0; width: 30px; height: 30px; margin: 0 12px 0 0; padding: 0; border-radius: 15px; background-color: var(--accent-soft); color: var(--accent); font-size: 14px; -unity-font-definition: url("Fonts/AtkinsonHyperlegible-Bold.ttf"); -unity-text-align: middle-center; }

/* Status pills hug their text (blueprint V1, V2, 5c "Now"). */
.pill { align-self: flex-start; flex-shrink: 0; margin: 4px 0 0 0; padding: 2px 9px; border-radius: 10px; font-size: 12px; -unity-font-definition: url("Fonts/AtkinsonHyperlegible-Bold.ttf"); color: var(--muted); background-color: var(--ground); }
.pill--ok { color: var(--accent); background-color: var(--accent-soft); }
.pill--warning { color: var(--warning-text); background-color: var(--warning-bg); }
.pill--solid { color: #FFFFFF; background-color: var(--accent); margin: 0 0 3px 0; }
.state-pill { align-self: flex-start; }

/* Search fields: magnifier at the left, accent border (V1, 2). */
.text-field--search > .unity-text-field__input { padding-left: 46px; border-width: 2px; border-color: var(--accent); }
.text-field-icon { position: absolute; left: 14px; top: 14px; }
.text-field > .unity-text-field__input { font-size: 16px; }

/* Icon tiles. */
.icon-tile--warning { background-color: #FCE8BF; }
.icon-tile--quiet { background-color: var(--ground); }
.icon-tile--solid { background-color: var(--accent); }
.icon-tile--large { width: 60px; height: 60px; margin: 0 0 16px 0; border-radius: 18px; background-color: var(--surface); border-width: 1px; border-color: var(--border); }

/* V1b: nothing matches. */
.empty-state { flex-grow: 1; align-items: center; padding-top: 48px; }
.empty-state > Button { align-self: stretch; }
.empty-title { -unity-text-align: middle-center; margin-bottom: 10px; }
.empty-text { -unity-text-align: middle-center; padding: 0 16px; }

/* V2 header: round back button and a label. */
.header-row { flex-shrink: 0; margin: 0 0 12px 0; }
.back-button { align-items: center; justify-content: center; padding: 0; font-size: 16px; }
.back-button--surface { background-color: var(--surface); border-width: 1px; border-color: var(--border); }

/* 2: the building chip with the blue "you" dot. */
.chip--place { flex-shrink: 1; padding: 8px 12px; border-radius: 20px; }
.chip-text { flex-shrink: 1; font-size: 13px; color: var(--text); white-space: normal; padding: 0; margin: 0; }
.you-dot { flex-shrink: 0; width: 8px; height: 8px; margin-right: 8px; border-radius: 4px; background-color: var(--you); }

/* 5: time first, then distance and how the floor changes; options in one card. */
.summary-row { align-items: flex-end; margin: 0 0 12px 0; }
.route-summary { font-size: 24px; margin: 0 10px 0 0; padding: 0; }
.summary-detail { font-size: 14px; margin: 0 0 3px 0; padding: 0; }
.route-option { flex-shrink: 0; min-height: 44px; margin: 0 0 0 10px; padding: 0; border-width: 0; border-radius: 0; justify-content: center; }
.route-sheet > .list-card { margin-bottom: 4px; }
.route-sheet > .warning { align-items: flex-start; padding: 12px; margin-bottom: 10px; }
.warning-text { font-size: 14px; }

/* S: the first-start tip. */
.first-tip-option { align-items: center; }
.first-tip-icon { width: 24px; height: 24px; margin-bottom: 6px; }
.first-tip-text { -unity-text-align: middle-center; }
.first-tip-note { margin: 0 0 12px 0; }

/* Sheets reach the bottom edge of the screen; the safe area is inside them, not a grey band under them. */
.route-screen { padding: 60px 0 0 0; }
.route-sheet { padding: 10px 20px 42px 20px; }
.card-button { flex-shrink: 0; margin: 0 0 0 8px; padding: 0 16px; }
.route-screen > .instruction-card { flex-shrink: 0; }

/* Steps, details, tips and the floor picker open as a sheet from the bottom, within reach of the thumb. */
.overlay--bottom { justify-content: flex-end; padding: 0; }
.overlay--bottom > .dialog-sheet { max-height: 82%; padding: 10px 20px 42px 20px; border-bottom-left-radius: 0; border-bottom-right-radius: 0; }
.overlay--bottom > .dialog-sheet > .small { margin: 0 0 12px 0; }
.dialog-sheet > * { flex-shrink: 0; }
.dialog-sheet > .dialog-body { flex-shrink: 1; }

/* D: floor names read as labels, not as markers. */
.miniature-floor { color: var(--text); background-color: rgba(255, 255, 255, 0.92); }
.miniature-floor--you { color: var(--text); }
.list-copy > .pill { margin: 4px 0 0 0; padding: 2px 9px; }
.list-copy > .pill--solid { margin: 0 0 4px 0; }

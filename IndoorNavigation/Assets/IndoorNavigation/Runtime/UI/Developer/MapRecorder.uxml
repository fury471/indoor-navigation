<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <!-- Developer only: record or continue a world map and mark its door corners. The camera shows
         through; the crosshair is the exact middle of the screen, where marks are raycast.
         Top: the map's name, progress and the next step, and the live map. Bottom: the door chips
         (tap one to name the door or mark it again), Undo and Mark, then Close and Save. The chips wrap onto
         at most a few rows and page with "More", so nothing grows with the number of doors. -->
    <Style src="../Tokens.uss" />
    <ui:VisualElement class="recorder">
        <!-- Top card: the map's name, progress and the next step, with the live map beside them, so the
             middle of the screen stays clear for the crosshair on every phone. -->
        <ui:VisualElement class="card recorder-card">
            <ui:VisualElement class="row recorder-card-row">
                <ui:VisualElement class="recorder-text">
                    <ui:Label name="area" class="strong" />
                    <ui:Label name="progress" class="small recorder-progress" />
                    <ui:Label name="status" class="small recorder-message" />
                </ui:VisualElement>
                <!-- Live map of what the recording has covered: seen from above, centred on you, facing up. -->
                <ui:VisualElement class="coverage-box" picking-mode="Ignore">
                    <ui:Label name="mapping" class="mapping-badge" picking-mode="Ignore" />
                    <ui:VisualElement name="coverage" class="coverage" picking-mode="Ignore" />
                    <ui:Label name="coverage-text" class="coverage-text" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="spacer" picking-mode="Ignore" />
        <ui:VisualElement class="sheet recorder-sheet">
            <!-- Opened by tapping a door chip: name the door for visitors, or mark it again. -->
            <ui:VisualElement name="door-sheet" class="door-sheet">
                <ui:Label name="door-title" class="strong" />
                <ui:TextField name="door-name" class="text-field" />
                <ui:Label text="What visitors call it, such as VR lab, Lift or Toilets. They choose doors by this name." class="small" />
                <ui:Toggle name="door-room" label="People may start inside this room" class="door-room" />
                <ui:VisualElement class="row recorder-row">
                    <ui:Button name="door-redo" text="Mark again" class="button recorder-button" />
                    <ui:Button name="door-done" text="Done" class="button button--primary recorder-button recorder-button--wide" />
                </ui:VisualElement>
            </ui:VisualElement>
            <!-- Not a ScrollView: on a touch screen a scroll view takes a short tap as the start of a drag,
                 so the chips inside it never got their click (build 9). -->
            <ui:VisualElement name="doors" class="recorder-doors" />
            <ui:VisualElement name="mark-row" class="row recorder-row">
                <ui:Button name="undo" text="Undo" class="button recorder-button" />
                <ui:Button name="mark" text="Mark d1-left" class="button button--accent recorder-button recorder-button--wide" />
            </ui:VisualElement>
            <ui:VisualElement name="save-row" class="row recorder-row">
                <ui:Button name="close" text="Close" class="button recorder-button" />
                <ui:Button name="save" text="Save map" class="button button--primary recorder-button recorder-button--wide" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="crosshair" class="crosshair" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>

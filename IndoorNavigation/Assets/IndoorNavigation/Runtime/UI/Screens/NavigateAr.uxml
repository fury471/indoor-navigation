<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <!-- A · Phone raised: AR + minimap. Transparent, so the camera view shows through; the route ahead
         is drawn on the floor by the AR overlay. "Arrows look wrong?" fixes the position at a door. -->
    <Style src="../Tokens.uss" />
    <ui:VisualElement class="screen screen--transparent">
        <ui:VisualElement class="card">
            <ui:Label name="instruction" class="strong" />
            <ui:Label name="instruction-detail" class="small" />
        </ui:VisualElement>
        <ui:VisualElement class="row fix-row">
            <ui:Label name="destination" class="chip" />
            <ui:VisualElement name="ar-pin" class="ar-pin" picking-mode="Ignore">
            <ui:VisualElement name="ar-pin-icon" class="ar-pin-icon" picking-mode="Ignore" />
            <ui:Label name="ar-pin-label" class="ar-pin-label" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement class="spacer" />
            <ui:Button name="fix-position" text="Arrows look wrong?" class="button button--small" />
        </ui:VisualElement>
        <ui:VisualElement class="spacer" />
        <ui:VisualElement name="minimap" class="minimap" />
    </ui:VisualElement>
</ui:UXML>

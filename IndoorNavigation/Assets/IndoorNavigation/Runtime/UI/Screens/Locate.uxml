<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <!-- 1 · Finding your position -->
    <Style src="../Tokens.uss" />
    <ui:VisualElement class="screen screen--transparent">
        <ui:Label name="building" class="chip" />
        <ui:VisualElement class="spacer" />
        <ui:VisualElement class="sheet">
            <ui:Label text="Finding where you are" class="title" />
            <ui:Label text="Hold the phone up and slowly look around the room." class="body" />
            <ui:Label name="status" class="small" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <!-- V1 · Choose a building, V1b · No supported building matches, V2 · Building details and download -->
    <Style src="../Tokens.uss" />
    <ui:VisualElement class="screen">
        <ui:VisualElement name="search-view" class="visitor-scroll">
            <ui:Label text="Which building are you in?" class="title" />
            <ui:Label text="The app works in buildings that have been mapped. Pick yours to download its map." class="body" />
            <ui:TextField name="query" tooltip="Search by building name" class="text-field" />
            <ui:Label name="supported-label" text="Supported buildings" class="section-label" />
            <ui:ScrollView name="venue-list" class="visitor-scroll" horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" />
            <ui:VisualElement name="empty" class="empty-state">
                <ui:VisualElement name="empty-icon" class="icon-tile icon-tile--large" />
                <ui:Label text="No supported building matches" class="sheet-title empty-title" />
                <ui:Label text="The app only works in buildings that have been mapped. Check the name, or pick a building from the list." class="body empty-text" />
                <ui:VisualElement class="spacer" />
                <ui:Button name="show-all" text="Show supported buildings" class="button button--primary" />
            </ui:VisualElement>
            <ui:Label name="not-listed" text="Not in the list? Your building hasn't been mapped yet, so the app can't guide you there." class="small footnote" />
        </ui:VisualElement>
        <ui:VisualElement name="details-view" class="visitor-scroll">
            <ui:VisualElement class="row header-row">
                <ui:Button name="back" tooltip="Back to the buildings" class="back-button back-button--surface" />
                <ui:Label text="Building" class="header-label" />
            </ui:VisualElement>
            <ui:Label name="venue-name" class="title" />
            <ui:Label name="venue-status" class="pill" />
            <ui:Label text="What's mapped" class="section-label" />
            <ui:VisualElement class="card">
                <ui:Label name="coverage" class="list-title" />
                <ui:Label text="Other parts of the building aren't mapped yet." class="small" />
            </ui:VisualElement>
            <ui:Label text="Download" class="section-label" />
            <ui:VisualElement name="download-card" class="list-card" />
            <ui:Label text="Use Wi-Fi if you can. The map stays on this phone, so later visits start faster." class="small footnote" />
            <ui:VisualElement class="spacer" />
            <ui:Button name="download" text="Download and continue" class="button button--primary" />
            <ui:Button name="another" text="Choose another building" class="button" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

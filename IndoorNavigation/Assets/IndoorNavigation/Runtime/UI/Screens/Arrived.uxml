<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <!-- G · Arrived -->
    <Style src="../Tokens.uss" />
    <ui:VisualElement class="screen">
        <ui:VisualElement class="spacer" />
        <ui:VisualElement class="sheet">
            <ui:Label text="You've arrived" class="title" />
            <ui:Label name="place" class="strong" />
            <ui:Label name="where" class="body" />
            <ui:Label name="hint" class="body" />
            <ui:Label name="checked" class="small" />
            <ui:Button name="found-it" text="Found it" class="button button--primary" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="../Tokens.uss" />
    <ui:VisualElement class="screen route-screen">
        <ui:VisualElement class="instruction-card">
            <ui:VisualElement name="arrived-icon" class="icon-tile icon-tile--solid" />
            <ui:VisualElement class="instruction-copy">
                <ui:Label text="You've arrived" class="instruction-title" />
                <ui:Label name="place" class="small" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="map" class="map route-map">
            <ui:Label text="Destination on the map" class="map-status" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement class="sheet route-sheet">
            <ui:VisualElement class="sheet-handle" />
            <ui:Label name="where" class="sheet-title" />
            <ui:Label name="hint" class="body" />
            <ui:Label name="checked" class="small sheet-copy" />
            <ui:Button name="found-it" text="Found it" class="button button--primary" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

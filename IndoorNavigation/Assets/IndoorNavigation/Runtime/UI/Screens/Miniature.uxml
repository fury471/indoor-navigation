<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="../Tokens.uss" />
    <ui:VisualElement class="screen route-screen">
        <ui:Button name="steps" tooltip="Read route steps" class="instruction-card">
            <ui:VisualElement name="instruction-icon" class="icon-tile" picking-mode="Ignore" />
            <ui:VisualElement class="instruction-copy" picking-mode="Ignore">
                <ui:Label name="instruction" class="instruction-title" />
                <ui:Label name="summary" class="small" />
            </ui:VisualElement>
        </ui:Button>
        <ui:VisualElement name="viewport" class="map route-map miniature-view">
            <ui:VisualElement name="labels" class="miniature-labels" picking-mode="Ignore" />
            <ui:VisualElement class="segmented segmented--map">
                <ui:Button name="show-2d" text="2D" class="segment" />
                <ui:Button name="show-3d" text="3D" class="segment segment--on" />
            </ui:VisualElement>
            <ui:Label name="hint" text="Drag to rotate · pinch to zoom" class="miniature-hint" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement class="sheet route-sheet">
            <ui:VisualElement class="sheet-handle" />
            <ui:Label name="destination" class="sheet-title sheet-copy" />
            <ui:VisualElement class="row">
                <ui:Button name="reset-view" text="Reset view" class="button half-button" />
                <ui:Button name="back-to-route" text="Back to route" class="button button--primary half-button" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
